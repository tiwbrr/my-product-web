ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@mystore.local
ADMIN_PASSWORD=Admin@12345
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side Supabase access. Never expose the secret key to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-secret-key

# Web Push notifications. Generate once with: npx web-push generate-vapid-keys
# Both variables stay server-side; only VAPID_PUBLIC_KEY is returned by the config API.
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com

# Optional server fallback. Admin uploads override this MP3, WAV, or OGG URL.
# Leave empty to use the admin upload or the built-in two-beat sound.
NOTIFICATION_SOUND_URL=
